# Port for the API server
PORT=5000

# MongoDB connection string.
# If MongoDB is not reachable, the server automatically runs in DEMO mode
# with in-memory data (no database needed).
MONGODB_URI=mongodb://127.0.0.1:27017/dps_ngo

# Admin panel credentials (used by the /api/admin/login endpoint)
ADMIN_PASSWORD=admin123
ADMIN_SECRET=change-this-secret